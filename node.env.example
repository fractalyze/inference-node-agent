# Per-node values: copy to node.env (git-ignored) and fill in. Fractalyze
# provides every value below except the engine address, which goes in
# targets/engine.json.
#
# The password goes in single quotes, e.g. PUSH_PASSWORD='ab$cd9': compose
# interpolates `$` in unquoted and double-quoted values (unquoted, that one
# would arrive as `ab`). A single-quoted value is taken literally and cannot
# itself contain a single quote.

# --- Identity: labels on every series this node pushes ---
# Unique name of this node; also its basic-auth user at the push endpoint.
NODE_NAME=
# Name of the provider operating this node.
CLOUD=
# Region or site of the node, e.g. us-east-1.
REGION=
# The model pool this node serves.
POOL=
# This node's role in its pool: unified, prefill or decode.
ROLE=

# --- Push endpoint (outbound HTTPS only) ---
# Prometheus remote-write URL, e.g. https://obs.example.com/api/v1/write.
METRICS_PUSH_URL=
# This node's push password. Single-quoted (see the top).
PUSH_PASSWORD=
